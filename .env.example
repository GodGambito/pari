# ==============================================================================
# Base de Datos (Neon Serverless PostgreSQL)
# Obtén tu connection string desde la consola de Neon (con sslmode=require)
# ==============================================================================
DATABASE_URL="postgresql://user:password@ep-cool-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ==============================================================================
# Autenticación (Auth.js / NextAuth v5)
# Generar con: npx auth secret  (o `openssl rand -base64 33`)
# ==============================================================================
AUTH_SECRET="tu_secreto_super_seguro_generado_con_openssl"

# Google OAuth Credentials (desde Google Cloud Console -> APIs & Services -> Credentials)
# URI de redirección autorizada: http://localhost:3000/api/auth/callback/google
# En producción: https://tu-dominio.vercel.app/api/auth/callback/google
AUTH_GOOGLE_ID="tu-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="GOCSPX-tu-google-client-secret"

# ==============================================================================
# Configuración de Aplicación & PWA
# ==============================================================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_CURRENCY="CLP"

# (Opcional) Proveedor de Tasas de Cambio para congelar tipo de cambio histórico
# Ejemplo: OpenExchangeRates o ExchangeRate-API (Frankfurter no requiere key)
EXCHANGE_RATE_API_KEY=""
